# ---------------------------------------------------------------------------
# Copy to .env (development) and set real values. Never commit .env files.
# Production secrets belong in the hosting platform's secret manager.
# ---------------------------------------------------------------------------

# Runtime environment label: development | staging | production
APP_ENV=development

# Public canonical origin, no trailing slash. Used for canonical URLs, sitemap, emails.
SITE_URL=http://localhost:3000

# Allow search engines to index this deployment. Keep false outside production.
SITE_INDEXABLE=false

# PostgreSQL connection string (use sslmode=require for managed databases).
DATABASE_URL=postgresql://app:app@127.0.0.1:5433/corpweb?schema=public

# 32+ random bytes, base64. Generate with: openssl rand -base64 32
# Signs form tokens and hashes IP addresses for rate limiting.
APP_SECRET=change-me-generate-with-openssl-rand-base64-32
# 32 random bytes, base64. Encrypts TOTP secrets at rest. Rotating it invalidates MFA enrolments.
APP_ENCRYPTION_KEY=change-me-generate-with-openssl-rand-base64-32

# Trust X-Forwarded-For from a reverse proxy / CDN (true only behind a trusted proxy).
TRUST_PROXY=false

# Require MFA (TOTP) for every admin account. Strongly recommended in staging/production.
ADMIN_MFA_REQUIRED=true
# Admin session lifetime in minutes.
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Email: "console" (development only, logs messages) or "smtp" (SES SMTP, SendGrid SMTP, Postmark, etc.)
EMAIL_PROVIDER=console
EMAIL_FROM="Website <no-reply@example.com>"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false

# Where operational alerts (e.g. notification retries exhausted) are sent.
OPS_ALERT_EMAIL=

# Media storage directory (persistent volume in production).
MEDIA_STORAGE_DIR=./storage/media

# Shared secret for the scheduled jobs endpoint (POST /api/internal/jobs). Leave empty to disable.
CRON_SECRET=

# Optional analytics (loaded only after consent where consent is required).
# Plausible-compatible script URL and domain, e.g. https://plausible.io/js/script.js
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=
NEXT_PUBLIC_ANALYTICS_DOMAIN=
